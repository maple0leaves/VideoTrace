# Local Docker environment. Copy this file to .env.
# PUBLIC_ORIGIN is the exact origin shown in the browser address bar.
PUBLIC_ORIGIN=http://localhost
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80

# Domestic dependency mirrors used while building images.
DOCKER_HUB_PROXY=m.daocloud.io/docker.io/library
UBUNTU_MIRROR=https://repo.huaweicloud.com/ubuntu
PYPI_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
NPM_REGISTRY=https://repo.huaweicloud.com/repository/npm/

# Keep local Docker data inside the project workspace.
VIDEOTRACE_DATA_DIR=./data

# Generate independent strong passwords before deployment.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_USERNAME=vidotrace
DB_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
VECTOR_DB_PASSWORD=replace-with-a-strong-vector-database-password
VECTOR_DIMENSION=1024
VECTOR_TABLE=video_chunk_vectors
MINIO_ACCESS_KEY=vidotrace
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=media

# Docker-internal MinIO address and same-origin browser playback path.
# Do not replace MINIO_INTERNAL_ENDPOINT with localhost or a public domain.
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PLAYBACK_PROXY_PREFIX=/media-storage

# Chat completion uses DeepSeek official first.
VIDEOTRACE_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# SiliconFlow is the chat fallback and still provides Embedding/ASR.
SILICONFLOW_API_KEY=replace-with-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_REQUEST_TIMEOUT_SECONDS=30
AGENT_MAX_DURATION_MS=120000
ANALYSIS_TASK_MAX_DURATION_MS=480000
VIDEO_CONTEXT_TIMEOUT_SECONDS=300
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR
ASR_REQUEST_TIMEOUT_SECONDS=60
ASR_MAX_ATTEMPTS=2
ASR_SEGMENT_PARALLELISM=2
OCR_TIMEOUT_SECONDS=30
OCR_FRAME_PARALLELISM=2
OCR_MAX_KEY_FRAMES=20
FFMPEG_MAX_CONCURRENT=2
