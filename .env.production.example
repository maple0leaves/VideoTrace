# Alibaba Cloud production application configuration.
# The shared databases, Redis, RocketMQ and Caddy are managed by Project-Deployment.
PUBLIC_ORIGIN=https://video.example.com
SHARED_NETWORK=shared-platform
VIDEOTRACE_DATA_DIR=/data/vidotrace

# Domestic dependency mirrors used while building images.
DOCKER_HUB_PROXY=m.daocloud.io/docker.io/library
UBUNTU_MIRROR=https://repo.huaweicloud.com/ubuntu
PYPI_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
NPM_REGISTRY=https://repo.huaweicloud.com/repository/npm/

# Values must match the corresponding entries in Project-Deployment/.env.
DB_URL=jdbc:mysql://shared-mysql:3306/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true
DB_USERNAME=vidotrace_app
DB_PASSWORD=replace-with-a-strong-database-password
REDIS_HOST=shared-redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DATABASE=0
VECTOR_DB_URL=jdbc:postgresql://shared-pgvector:5432/vidotrace_vectors
VECTOR_DB_USERNAME=vidotrace_vector
VECTOR_DB_PASSWORD=replace-with-a-strong-vector-database-password
VECTOR_DIMENSION=1024
VECTOR_TABLE=video_chunk_vectors
ROCKETMQ_NAME_SERVER=shared-rocketmq-namesrv:9876

# VideoTrace-owned object storage.
MINIO_ACCESS_KEY=vidotrace
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=media
MINIO_PLAYBACK_PROXY_PREFIX=/media-storage

# Chat completion uses DeepSeek official first.
VIDEOTRACE_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# SiliconFlow is the chat fallback and provides Embedding/ASR.
SILICONFLOW_API_KEY=replace-with-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_REQUEST_TIMEOUT_SECONDS=180
AGENT_MAX_DURATION_MS=600000
ANALYSIS_TASK_MAX_DURATION_MS=600000
VIDEO_CONTEXT_TIMEOUT_SECONDS=480
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR

# Conservative defaults for a host shared with MatchCV.
ANALYSIS_WORKERS=1
FFMPEG_MAX_CONCURRENT=1
ASR_SEGMENT_PARALLELISM=1
OCR_FRAME_PARALLELISM=1
